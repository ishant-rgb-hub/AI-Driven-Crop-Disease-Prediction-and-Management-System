generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cropImages   CropImage[]
  predictions  Prediction[]
  farms        Farm[]
}

model Crop {
  id                 Int          @id @default(autoincrement())
  cropName           String       @map("name")
  cropVariety        String?
  plantingDate       DateTime?
  expectedHarvestDate DateTime?
  growthStage        String?
  farmId             Int
  farm               Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  predictions        Prediction[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([farmId])
}

model Farm {
  id            Int      @id @default(autoincrement())
  farmName      String
  location      String
  totalArea     Float
  soilType      String
  irrigationType String
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  crops         Crop[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// Member B: proposed Prisma models (Disease, CropImage, Prediction)
// To be merged into backend/prisma/schema.prisma by Member A.
// Assumes Member A's models: User (id Int) and Crop (id Int). Adjust id types if they differ.

model Disease {
  id          Int      @id @default(autoincrement())
  name        String   @unique   // must match the AI model's output label, e.g. "Tomato___Late_blight"
  cropName    String             // e.g. "Tomato"
  displayName String             // e.g. "Late Blight"
  description String
  symptoms    String
  isHealthy   Boolean  @default(false) // true for "healthy" classes
  createdAt   DateTime @default(now())

  predictions Prediction[]
  treatments  Treatment[]
  preventions Prevention[]

  // Member C will add: treatments Treatment[], preventions Prevention[]
}

model CropImage {
  id         Int      @id @default(autoincrement())
  url        String   // path or URL where the file is stored
  filename   String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  predictions Prediction[]

  @@index([userId])
}

model Prediction {
  id         Int      @id @default(autoincrement())
  confidence Float    // 0.0 to 1.0
  rawLabel   String   // label returned by the AI, kept for debugging
  createdAt  DateTime @default(now())

  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  cropId    Int?
  crop      Crop?     @relation(fields: [cropId], references: [id], onDelete: SetNull)

  imageId   Int
  image     CropImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  diseaseId Int
  disease   Disease   @relation(fields: [diseaseId], references: [id])

  // Member C will add: recommendations Recommendation[], feedback PredictionFeedback[]
  recommendations Recommendation[]
feedback       PredictionFeedback?

  @@index([userId, createdAt])
}

// Member A must add the back-relations:
//   in User:  cropImages CropImage[]   predictions Prediction[]
//   in Crop:  predictions Prediction[]



model Treatment {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  applicationMethod String
  safetyNotes     String?
  createdAt       DateTime @default(now())

  diseaseId       Int
  disease         Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@index([diseaseId])
}

model Prevention {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  diseaseId   Int
  disease     Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)

  @@index([diseaseId])
}

model Recommendation {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  category     String
  priority     String   @default("normal")
  createdAt    DateTime @default(now())

  predictionId Int
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId])
}

model PredictionFeedback {
  id           Int      @id @default(autoincrement())
  rating       Int
  isCorrect    Boolean?
  comment      String?
  createdAt    DateTime @default(now())

  predictionId Int      @unique
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}
